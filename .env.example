# Sentient Wallet local orchestration defaults.
# Copy this file to .env only when overriding the built-in Compose defaults.
COMPOSE_PROJECT_NAME=sentient-wallet

# Host ports (container ports remain fixed at 8080 / 8000 / 8545).
FRONTEND_PORT=8080
API_PORT=8000
HARDHAT_PORT=8545

# Full Local mode. Demo mode (`make demo`) does not start these services.
SENTIENT_ENV=development
SENTIENT_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HARDHAT_RPC_URL=http://hardhat:8545
HARDHAT_CHAIN_ID=31337

# The API and deployer derive the same disposable signer at runtime from this
# public label. It is restricted to local chain ID 31337 and is not a secret.
SENTIENT_DEV_SIGNER_LABEL=sentient-wallet/local-dev-risk-signer/v1
# To override it, set SENTIENT_DEV_ATTESTATION_KEY only in the ignored `.env`.
# Never commit, fund, or reuse an override on a public or production network.

# Deterministic addresses produced by the first deployment on a fresh local node.
SENTIENT_POLICY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
SENTIENT_ACCOUNT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
