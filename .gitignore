# Node and package managers
/node_modules/
/contracts/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# JavaScript build and runtime output
/.next/
/.vinext/
/dist/
/out/
/coverage/
/.wrangler/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python environments and caches
__pycache__/
*.py[cod]
*.pyd
*.so
.Python
.venv/
venv/
env/
backend/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Generated ML working data (browser artifacts in assets/models are committed)
/ml/data/*
!/ml/data/.gitignore
/ml/artifacts/*
!/ml/artifacts/.gitignore

# Hardhat output
/contracts/artifacts/
/contracts/cache/
/contracts/coverage/
/contracts/typechain-types/

# Test and local runtime output
/playwright-report/
/test-results/
/outputs/
/work/
/tmp/
*.sqlite
*.sqlite3

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Hosting/tool caches
.vercel/
